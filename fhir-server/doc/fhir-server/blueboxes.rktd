raco fhir-server serve-ig <package> [–port n]                         a server generated from the IG; its examples loaded
–capability <id|url>                                                  which server CapabilityStatement, when the IG ships several
–load <dir|file>                                                      Bundles, resources or .cql files (as Library resources)
–db store.db                                                          keep the store between runs (SQLite)
–gaps                                                                 print what the IG asks for that is not served, and stop
–bearer <token>, –tz-offset ±hh:mm, –no-examples, –no-validate        a static token; the evaluation timezone; skip the examples or the write
                                                                      validation
raco fhir-server serve app.rkt [port]                                 a #lang fhir/capability app
raco fhir-server load store.db data/                                  prepopulate a store
raco fhir-server evaluate-measure store.db <Measure> –period-start d  a MeasureReport from the store
–period-end d [–subject Patient/x]
struct
(struct app (capability-statement
             operation-definitions
             repositories
             operations
             transaction
             metadata))
  capability-statement : fhir?
  operation-definitions : list?
  repositories : hash?
  operations : hash?
  transaction : (or/c procedure? #f)
  metadata : hash?
struct
(struct repository (read
                    vread
                    create
                    update
                    delete
                    search
                    history
                    patch))
  read : any/c
  vread : any/c
  create : any/c
  update : any/c
  delete : any/c
  search : any/c
  history : any/c
  patch : any/c
