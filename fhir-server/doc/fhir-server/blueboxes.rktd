(make-repository [#:read read           
                  #:vread vread         
                  #:create create       
                  #:update update       
                  #:delete delete       
                  #:search search       
                  #:history history     
                  #:patch patch])   -> repository?
  read : any/c = #f
  vread : any/c = #f
  create : any/c = #f
  update : any/c = #f
  delete : any/c = #f
  search : any/c = #f
  history : any/c = #f
  patch : any/c = #f
