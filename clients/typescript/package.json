{
  "name": "fhir-toolkit",
  "version": "0.1.0",
  "description": "FHIR and its languages from TypeScript and JavaScript: FSH, CQL, FHIRPath, the mapping language, VCL and SQL on FHIR views compiled, checked, run and validated",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node generate.mjs",
    "build": "tsc -p .",
    "test": "node generate.mjs --check && tsc -p . && node --test test/*.test.mjs"
  },
  "keywords": [
    "fhir",
    "fsh",
    "cql",
    "fhirpath",
    "sql-on-fhir",
    "healthcare"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oloveluck/fhir.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://oloveluck.github.io/fhir/",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
